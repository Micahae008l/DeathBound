{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Chained Prophet",
    "color": "#9b7be0",
    "bold": true
  },
  "external_title": {
    "text": "The Chained Prophet"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "The Hunter was here before the throne had a name. The first living soul to come down.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "They offered him the crown. He laughed and walked west, and he's hunted whatever comes down ever since.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Don't go west unless you mean it. He never misses twice.",
        "color": "#c7b2ff",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "prophet"
      }
    }
  ]
}
