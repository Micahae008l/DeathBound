{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Chained Prophet",
    "color": "#9b7be0",
    "bold": true
  },
  "external_title": {
    "text": "The Chained Prophet"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "You beat the Warden. Remember: the moment someone sits on that throne, he serves them again.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "The Death King is afraid of you. He melted every chain he could find. Every one but one.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Yours. Ask yourself how it found you.",
        "color": "#c7b2ff",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "His gate is sealed."
      },
      "width": 250,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "deathbound:prophet_seals"
      }
    },
    {
      "label": {
        "text": "How did it find me?"
      },
      "width": 250,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "deathbound:prophet_found"
      }
    },
    {
      "label": {
        "text": "How do I beat the Death King?"
      },
      "width": 250,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "deathbound:prophet_death"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Leave"
    },
    "width": 250
  }
}
