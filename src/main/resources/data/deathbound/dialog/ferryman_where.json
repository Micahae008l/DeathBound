{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Ferryman",
    "color": "#9d8f6e",
    "bold": true
  },
  "external_title": {
    "text": "The Ferryman"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "This is the old landing. The river ran right here. Now it's a ditch full of bones.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "The bridges meet at the Crossing. West is the Ghostwood. East is Lantern's End, where Aldous lives. North-west of the Crossing is the Crypt. Something hangs in chains down there.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "North is the Great Door. Past it, the Citadel, where the Lake used to be.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "If you die down here, I'll keep your things. Come back and ask.",
        "color": "#cdc4ae",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "ferryman"
      }
    }
  ]
}
