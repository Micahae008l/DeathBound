{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Ferryman",
    "color": "#9d8f6e",
    "bold": true
  },
  "external_title": {
    "text": "The Ferryman"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "I'm the Ferryman. When people died, I rowed their souls down the River of the Dead to the Warden at the Great Door.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He judged them. The good went through the Door, into the Lake of Souls, to rest. That was the order of things.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Now the river is dust and I still hold the oars. Habit.",
        "color": "#cdc4ae",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "ferryman"
      }
    }
  ]
}
