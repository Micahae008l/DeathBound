{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Clatter, the Bonesmith",
    "color": "#a3adbd",
    "bold": true
  },
  "external_title": {
    "text": "Clatter, the Bonesmith"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He pats his chest. Then he draws a bow in the air, and puts a crown on his head with both hands.",
        "color": "#cdd3dd",
        "italic": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Ysolde, the second King, built him out of the bones of the first smiths. She wanted a smith who would never leave.",
        "color": "#cdd3dd"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He looks at the bridge to the Landing for a long time. He has never crossed it.",
        "color": "#cdd3dd",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "bonesmith"
      }
    }
  ]
}
