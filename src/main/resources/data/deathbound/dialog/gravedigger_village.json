{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Aldous, the Traveler",
    "color": "#b08d5c",
    "bold": true
  },
  "external_title": {
    "text": "Aldous, the Traveler"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "This is Lantern's End. These people died in their sleep and never noticed. They kept sweeping and cooking.",
        "color": "#dcc9a8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "But the line never moved, and nobody came for them. After a while, they just... sat down.",
        "color": "#dcc9a8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "I dig graves for them. It keeps my hands busy. Some of them still twitch when you walk past. Don't stare.",
        "color": "#dcc9a8",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "gravedigger"
      }
    }
  ]
}
