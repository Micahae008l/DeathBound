{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Lamplighter",
    "color": "#b9b2c9",
    "bold": true
  },
  "external_title": {
    "text": "The Lamplighter"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Lantern's End was where the dead stopped on the way to the Door. A last night somewhere warm. Bread, a bed, a song.",
        "color": "#d8d2e2"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Then the line stopped moving, and the town stopped being a stop. Now it's just where they wait.",
        "color": "#d8d2e2",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "lamplighter"
      }
    }
  ]
}
