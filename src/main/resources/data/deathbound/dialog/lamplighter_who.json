{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Lamplighter",
    "color": "#b9b2c9",
    "bold": true
  },
  "external_title": {
    "text": "The Lamplighter"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "I lit lamps up top, for forty years. When I died I came down and there were lamps here too, going out. So.",
        "color": "#d8d2e2"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Nobody asked me. Nobody needed to.",
        "color": "#d8d2e2",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "lamplighter"
      }
    }
  ]
}
