{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Mira",
    "color": "#a9bfe0",
    "bold": true
  },
  "external_title": {
    "text": "Mira"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "I'm Mira. I'm nine. I'll be nine forever now, which is fine, nine is the best one.",
        "color": "#d6e2f5"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "The soldier at the door says I'm good. So I just have to wait until it opens.",
        "color": "#d6e2f5"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Don't tell Papa I'm here. He'd try to come and get me, and he's not supposed to be down here. He's alive.",
        "color": "#d6e2f5",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "mira"
      }
    }
  ]
