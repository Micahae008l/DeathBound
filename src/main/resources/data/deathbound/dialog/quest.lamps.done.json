{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Lamplighter",
    "color": "#b9b2c9",
    "bold": true
  },
  "external_title": {
    "text": "The Lamplighter"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He tips the souls into his lamp one at a time. The street brightens, a little.",
        "color": "#d8d2e2",
        "italic": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "And this is for you. A wisp of my own lamp, in a lantern of its own. Hold it up and it'll wake. It'll warn you when the dead come close.",
        "color": "#d8d2e2"
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:talk",
        "payload": "lamplighter"
      }
    }
  ]
}
