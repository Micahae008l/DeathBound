{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Old King",
    "color": "#c9a8ff",
    "bold": true
  },
  "external_title": {
    "text": "The Old King"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Have I? I can hear the whole Underworld from this chair. Every soul in the line. Every one that ever got away.",
        "color": "#e2d3ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Silas heard it too, at the end. He said it sounded like hunger. I always thought he was weak.",
        "color": "#e2d3ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Go. Before I start listening to you.",
        "color": "#e2d3ff",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "prophet"
      }
    }
  ]
}
