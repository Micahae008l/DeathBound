{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Ferryman",
    "color": "#9d8f6e",
    "bold": true
  },
  "external_title": {
    "text": "The Ferryman"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Your Majesty. Forgive me if I don't bow. I've bowed to four of you.",
        "color": "#cdc4ae"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "They all said they'd go home, too.",
        "color": "#cdc4ae",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Do you have my things?"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:reclaim"
      }
    },
    {
      "label": {
        "text": "Show me what you sell."
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:trade"
      }
    },
    {
      "label": {
        "text": "Can I do anything for you?"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:quest",
        "payload": "ferryman"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Leave"
    },
    "width": 250
  }
}
