{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Old King",
    "color": "#c9a8ff",
    "bold": true
  },
  "external_title": {
    "text": "The Old King"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Do you know where he hung me? Over my own grave. The empty one, in the Tomb of Kings.",
        "color": "#e2d3ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Every King gets a tomb. Mine had no body in it, because the dead can't die. So he made me hang over it, every day, for every year.",
        "color": "#e2d3ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He thought it was cruel. It was. It also taught me patience.",
        "color": "#e2d3ff",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "prophet"
      }
    }
  ]
}
