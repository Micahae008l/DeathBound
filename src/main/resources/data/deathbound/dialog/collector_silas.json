{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Collector",
    "color": "#8fa877",
    "bold": true
  },
  "external_title": {
    "text": "The Collector"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "What did he leave? A throne nobody wants and a hole where a lake used to be.",
        "color": "#c9d6b8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "And his ring. Kings always leave a ring.",
        "color": "#c9d6b8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Every King thinks he's the last one. Every King is wrong. I have their rings to prove it.",
        "color": "#c9d6b8",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "collector"
      }
    }
  ]
}
