{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Clatter, the Bonesmith",
    "color": "#a3adbd",
    "bold": true
  },
  "external_title": {
    "text": "Clatter, the Bonesmith"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He mimes a row of soldiers, a bow, a crown. Then each soldier falling over.",
        "color": "#cdd3dd",
        "italic": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Ysolde's guard. He made every one of their blades. None of them came back for them.",
        "color": "#cdd3dd"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "He points at the coffin by his forge. It's full of swords.",
        "color": "#cdd3dd",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "bonesmith"
      }
    }
  ]
}
