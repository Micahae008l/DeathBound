{
  "type": "minecraft:multi_action",
  "title": {
    "text": "The Chained Prophet",
    "color": "#9b7be0",
    "bold": true
  },
  "external_title": {
    "text": "The Chained Prophet"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Halden came first, of the ones you'd call Kings. A miner. He dug down with a pickaxe and took the throne with it.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Ysolde shot him off it from the far end of the hall. She was the best of us. She built things: the bridges you walk on, the little golem at the Mere.",
        "color": "#c7b2ff"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "And then me. I strangled Ysolde with her own bowstring. That's how it works, bearer. That's always how it works.",
        "color": "#c7b2ff",
        "italic": true
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Back"
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:back",
        "payload": "prophet"
      }
    }
  ]
}
