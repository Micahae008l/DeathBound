{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Aldous, the Traveler",
    "color": "#b08d5c",
    "bold": true
  },
  "external_title": {
    "text": "Aldous, the Traveler"
  },
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "You beat the Warden? Then the Door... Did you see her? Brown hair. Missing a tooth.",
        "color": "#dcc9a8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "The blind man came to me in a dream last night. He said if you fail, I should take the throne. He said a King can send a soul home.",
        "color": "#dcc9a8"
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "Could I? ...Don't answer that.",
        "color": "#dcc9a8",
        "italic": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "width": 310,
      "contents": {
        "text": "If you're after the bell at Lantern's End: I put a ladder up the tower. Nobody's rung it in years. Nobody living.",
        "color": "#dcc9a8"
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Can you make my armor stronger?"
      },
      "width": 250,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "deathbound:gravedigger_forge"
      }
    },
    {
      "label": {
        "text": "Let's trade."
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:trade"
      }
    },
    {
      "label": {
        "text": "About Mira..."
      },
      "width": 250,
      "action": {
        "type": "minecraft:custom",
        "id": "deathbound:quest",
        "payload": "gravedigger"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Leave"
    },
    "width": 250
  }
}
