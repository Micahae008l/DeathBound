{
	"schemaVersion": 1,
	"id": "deathbound",
	"version": "${version}",
	"name": "DeathBound",
	"description": "Conquer Death, or be forgotten. Bind your soul to the Deathbound Relic, die by choice, and cross into the Underworld: floating islands over a purple void, the Great Door, and Death's Citadel.",
	"authors": [
		"Michael"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/deathbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.deathbound.DeathBound"
		],
		"client": [
			"com.deathbound.client.DeathBoundClient"
		]
	},
	"mixins": [
		"deathbound.mixins.json",
		{
			"config": "deathbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
